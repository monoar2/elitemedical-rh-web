# Development (local) environment
VITE_API_BASE_URL=http://localhost:8082/rh
VITE_BASE_PATH=/rh-web/
# Optional: override websocket URL (defaults to `${VITE_API_BASE_URL}/ws`)
VITE_WS_URL=http://localhost:8082/rh/ws
# Dev server allowed hosts (comma-separated). Leave empty for default.
VITE_ALLOWED_HOSTS=localhost,127.0.0.1
